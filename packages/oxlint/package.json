{
	"name": "@w0s/oxlint-config",
	"version": "1.0.7",
	"description": "OxLint configuration file used on `w0s.jp`",
	"keywords": [
		"oxlint",
		"oxlint-config"
	],
	"license": "MIT",
	"author": "Saeki Tominaga",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SaekiTominaga/config.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./dist/configs/base.js",
		"./*": "./dist/configs/*.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prebuild": "rimraf dist/* -g",
		"build": "tsc",
		"test": "node __tests__/index.test.ts",
		"lint": "oxlint --ignore-pattern __tests__/invalid"
	},
	"devDependencies": {
		"oxlint": "^1.80.0",
		"oxlint-plugin-safely-storage": "^1.0.0",
		"oxlint-tsgolint": "^7.0.2001"
	},
	"peerDependencies": {
		"oxlint": "^1.80.0",
		"oxlint-plugin-safely-storage": "^1.0.0",
		"oxlint-tsgolint": "^7.0.2001"
	}
}
