{
	"name": "@w0s/oxlint-config",
	"version": "1.0.9",
	"description": "OxLint configuration file used on `w0s.jp`",
	"keywords": [
		"oxlint",
		"oxlint-config"
	],
	"license": "MIT",
	"author": "Saeki Tominaga",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SaekiTominaga/config.git"
	},
	"files": [
		"dist/configs",
		"dist/rules/**/*.js"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/configs/base.d.ts",
			"default": "./dist/configs/base.js"
		},
		"./browser": {
			"types": "./dist/configs/browser.d.ts",
			"default": "./dist/configs/browser.js"
		},
		"./node": {
			"types": "./dist/configs/node.d.ts",
			"default": "./dist/configs/node.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc",
		"test": "node __tests__/index.test.ts",
		"lint": "oxlint --ignore-pattern __tests__/invalid"
	},
	"devDependencies": {
		"oxlint": "^1.80.0",
		"oxlint-plugin-safely-storage": "^1.0.0",
		"oxlint-tsgolint": "^7.0.2001"
	},
	"peerDependencies": {
		"oxlint": "^1.80.0",
		"oxlint-plugin-safely-storage": "^1.0.0",
		"oxlint-tsgolint": "^7.0.2001"
	}
}
