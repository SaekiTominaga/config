{
	"name": "@w0s/tsconfig",
	"version": "3.2.1",
	"description": "TSConfig file used on `w0s.jp`",
	"keywords": [
		"tsconfig"
	],
	"license": "MIT",
	"author": "Saeki Tominaga",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SaekiTominaga/config.git"
	},
	"files": [
		"configs"
	],
	"type": "module",
	"exports": {
		".": "./configs/tsconfig.json",
		"./bundler": "./configs/tsconfig.bundler.json",
		"./node": "./configs/tsconfig.node.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "tsc -p __tests__/tsconfig-valid.json",
		"test:invalid": "tsc -p __tests__/tsconfig-invalid.json"
	},
	"devDependencies": {
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"typescript": "^6.0.0 || ^7.0.0"
	}
}
